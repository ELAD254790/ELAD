generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Habit {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    String        @default("general")
  frequency   String        @default("daily")
  color       String        @default("#6366f1")
  icon        String        @default("check")
  targetDays  Int           @default(7)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  logs        HabitLog[]
  schedules   HabitSchedule[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      String
  completed Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, date])
}

model HabitSchedule {
  id         String   @id @default(cuid())
  habitId    String
  dayOfWeek  Int
  time       String   @default("08:00")
  createdAt  DateTime @default(now())
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String      @id @default(cuid())
  title       String
  description String?
  category    String      @default("personal")
  targetDate  DateTime?
  progress    Int         @default(0)
  status      String      @default("active")
  priority    String      @default("medium")
  color       String      @default("#8b5cf6")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  milestones  Milestone[]
  tasks       GoalTask[]
  vision      GoalVision?
  deadline    GoalDeadline?
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalTask {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  description String?
  priority    String    @default("medium")
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalDeadline {
  id             String   @id @default(cuid())
  goalId         String   @unique
  deadline       DateTime
  alertDaysBefore Int     @default(7)
  alertSent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalVision {
  id              String   @id @default(cuid())
  goalId          String   @unique
  whyMatters      String?
  identityBehind  String?
  ifNeglected     String?
  ifCompleted     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  sources   String?
  createdAt DateTime @default(now())
}

model UploadedFile {
  id           String   @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String   @default("general")
  description  String?
  createdAt    DateTime @default(now())
}

model ProgressEntry {
  id        String   @id @default(cuid())
  date      String
  category  String
  metric    String
  value     Float
  note      String?
  createdAt DateTime @default(now())
}

model Identity {
  id              String   @id @default(cuid())
  whoBecoming     String?
  standards       String?
  nonNegotiables  String?
  rules           String?
  values          String?
  vision          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FocusPriority {
  id          String   @id @default(cuid())
  date        String   @unique
  priority1   String?
  priority2   String?
  priority3   String?
  currentTask String?
  nextAction  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyReview {
  id                  String   @id @default(cuid())
  weekDate            String   @unique
  completedThisWeek   String?
  inconsistentAreas   String?
  blockers            String?
  bestHabits          String?
  movedGoals          String?
  adjustments         String?
  topPriorities       String?
  wins                String?
  lessons             String?
  weeklyScore         Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RecoveryLog {
  id           String   @id @default(cuid())
  date         String
  whatHappened String
  trigger      String
  nextSmallWin String
  commitment   String
  createdAt    DateTime @default(now())
}
